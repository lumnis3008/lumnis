# Variáveis para o processo Node. Configure no ambiente do terminal ou hospedagem.
# O comando npm start não carrega este arquivo automaticamente.
# Sem senha definida, o Node gera uma senha em .local/admin-password.
# LUMNIS_ADMIN_PASSWORD=defina-uma-senha-longa-e-unica
# LUMNIS_DATA_DIR=/caminho/privado/dos/dados
HOST=127.0.0.1
PORT=4788
